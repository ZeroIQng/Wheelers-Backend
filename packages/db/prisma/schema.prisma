generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  privyDid      String         @unique
  walletAddress String?        @unique
  username      String?        @unique
  role          UserRole       @default(RIDER)
  name          String?
  phone         String?
  photoUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  email         String?
  driver        Driver?
  notifications Notification[]
  notificationDevices NotificationDevice[]
  consents      UserConsent[]
  wallet        Wallet?
  walletReservations WalletReservation[]
  withdrawalRequests WithdrawalRequest[]
  groupRideMatchRequests GroupRideMatchRequest[]
  groupRideFaceVerifications GroupRideFaceVerification[]
  referralCode  ReferralCode?
  referralsMade Referral[]          @relation("ReferralReferrer")
  referralReceived Referral?        @relation("ReferralReferred")
  referralCashbacks ReferralCashback[]

  @@index([privyDid])
  @@index([walletAddress])
  @@index([username])
  @@index([email])
}

model UserConsent {
  id             String      @id @default(uuid())
  userId         String
  consentType    ConsentType
  consentVersion String
  consentTxHash  String
  grantedAt      DateTime    @default(now())
  revokedAt      DateTime?
  user           User        @relation(fields: [userId], references: [id])

  @@unique([userId, consentType, consentVersion])
  @@index([userId])
}

model Driver {
  id                String            @id @default(uuid())
  userId            String            @unique
  status            DriverStatus      @default(OFFLINE)
  kycStatus         KycStatus         @default(PENDING)
  lat               Float?
  lng               Float?
  lastSeenAt        DateTime?
  vehicleMake       String?
  vehicleModel      String?
  vehiclePlate      String?
  vehicleYear       Int?
  licenceCid        String?
  insuranceCid      String?
  selfieHash        String?
  rating            Float             @default(5.0)
  totalRides        Int               @default(0)
  totalEarningsUsdt Decimal           @default(0) @db.Decimal(18, 6)
  user              User              @relation(fields: [userId], references: [id])
  kycReviews        DriverKycReview[]
  rides             Ride[]            @relation("DriverRides")

  @@index([status])
  @@index([kycStatus])
}

model DriverKycReview {
  id          String    @id @default(uuid())
  driverId    String
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  outcome     KycStatus
  notes       String?
  driver      Driver    @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

model Wallet {
  id             String          @id @default(uuid())
  userId         String          @unique
  address        String          @unique
  balanceUsdt    Decimal         @default(0) @db.Decimal(18, 6)
  lockedUsdt     Decimal         @default(0) @db.Decimal(18, 6)
  stakedUsdt     Decimal         @default(0) @db.Decimal(18, 6)
  chain          String          @default("base")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  defiPositions  DefiPosition[]
  rideHolds      RideHold[]
  transactions   Transaction[]
  virtualAccount VirtualAccount?
  reservations   WalletReservation[]
  withdrawals    WithdrawalRequest[]
  user           User            @relation(fields: [userId], references: [id])

  @@index([address])
}

model VirtualAccount {
  id            String   @id @default(uuid())
  walletId      String   @unique
  bankName      String
  accountNumber String
  accountName   String
  korapayRef    String   @unique
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id])
}

model PaymentRecord {
  id                       String              @id @default(uuid())
  paymentId                String              @unique
  userId                   String
  provider                 String
  providerReference        String              @unique
  userWallet               String
  amountLocal              Decimal             @db.Decimal(18, 2)
  amountUsdt               Decimal?            @db.Decimal(18, 6)
  exchangeRate             Decimal?            @db.Decimal(18, 6)
  status                   PaymentRecordStatus @default(RECEIVED)
  conversionLeaseExpiresAt DateTime?
  metadata                 Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  localCurrency            String              @default("NGN")

  @@index([userId, status])
}

model PaymentIntent {
  id                  String              @id @default(uuid())
  paymentId           String              @unique
  userId              String
  provider            String
  providerReference   String              @unique
  sessionType         PaymentSessionType
  lifecycleStatus     PaymentIntentStatus @default(PENDING)
  providerStatus      String
  userWallet          String
  amountUsd           Decimal             @db.Decimal(18, 6)
  amountLocal         Decimal?            @db.Decimal(18, 2)
  localCurrency       String              @default("NGN")
  cryptoCurrency      String
  cryptoNetwork       String
  cryptoAmount        Decimal?            @db.Decimal(18, 6)
  chain               String?
  customerEmail       String?
  walletTag           String?
  settlementReference String?
  providerPayload     Json?
  metadata            Json?
  lastSyncedAt        DateTime?
  settledAt           DateTime?
  failedAt            DateTime?
  expiresAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, lifecycleStatus])
  @@index([sessionType, lifecycleStatus])
}

model RideHold {
  id                String         @id @default(uuid())
  rideId            String         @unique
  walletId          String
  riderId           String
  amountUsdt        Decimal        @db.Decimal(18, 6)
  status            RideHoldStatus @default(ACTIVE)
  settledAmountUsdt Decimal?       @db.Decimal(18, 6)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  settledAt         DateTime?
  wallet            Wallet         @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@index([riderId, status])
}

model Transaction {
  id           String               @id @default(uuid())
  walletId     String
  type         TransactionType
  direction    TransactionDirection
  amountUsdt   Decimal              @db.Decimal(18, 6)
  balanceAfter Decimal              @db.Decimal(18, 6)
  referenceId  String
  metadata     Json?
  createdAt    DateTime             @default(now())
  wallet       Wallet               @relation(fields: [walletId], references: [id])

  @@unique([walletId, type, direction, referenceId])
  @@index([walletId, createdAt])
  @@index([referenceId])
}

model WalletReservation {
  id         String                  @id @default(uuid())
  walletId    String
  userId      String
  kind        WalletReservationKind
  status      WalletReservationStatus @default(ACTIVE)
  amountUsdt  Decimal                 @db.Decimal(18, 6)
  referenceId String                  @unique
  metadata    Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  releasedAt  DateTime?
  consumedAt  DateTime?
  user        User                    @relation(fields: [userId], references: [id])
  wallet      Wallet                  @relation(fields: [walletId], references: [id])
  withdrawal  WithdrawalRequest?

  @@index([walletId, status])
  @@index([userId, status])
}

model WithdrawalRequest {
  id                 String                  @id @default(uuid())
  userId             String
  walletId           String
  reservationId      String                  @unique
  paymentId          String?                 @unique
  providerReference  String?                 @unique
  status             WithdrawalRequestStatus @default(PENDING)
  requestedAmountNgn Decimal                 @db.Decimal(18, 2)
  quotedAmountNgn    Decimal?                @db.Decimal(18, 2)
  reservedAmountUsdt Decimal                 @db.Decimal(18, 6)
  quotedAmountUsd    Decimal?                @db.Decimal(18, 6)
  quotedCryptoAmount Decimal?                @db.Decimal(18, 6)
  displayCurrency    String                  @default("NGN")
  displayExchangeRate Decimal                @db.Decimal(18, 6)
  payoutCurrency     String                  @default("NGN")
  cryptoCurrency     String
  cryptoNetwork      String
  bankAccountNumber  String
  bankAccountName    String
  bankNetworkId      String
  failureReason      String?
  providerPayload    Json?
  expiresAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  settledAt          DateTime?
  failedAt           DateTime?
  releasedAt         DateTime?
  user               User                    @relation(fields: [userId], references: [id])
  wallet             Wallet                  @relation(fields: [walletId], references: [id])
  reservation        WalletReservation       @relation(fields: [reservationId], references: [id])

  @@index([userId, status, createdAt])
  @@index([walletId, status, createdAt])
}

model GroupRideMatchRequest {
  id                     String                      @id @default(uuid())
  userId                 String
  status                 GroupRideMatchRequestStatus @default(PENDING_FACE_UPLOAD)
  groupId                String?
  matchedRideIds         Json?
  pickupLat              Float
  pickupLng              Float
  pickupAddress          String
  destLat                Float
  destLng                Float
  destAddress            String
  genderPreference       GroupRideGenderPreference   @default(ANY)
  stops                  Json?
  plannedDistanceKm      Float?
  plannedDurationSeconds Int?
  fareEstimateUsdt       Decimal?                    @db.Decimal(18, 6)
  paymentMethod          ScheduledRidePaymentMethod  @default(WALLET_BALANCE)
  readyForMatchAt        DateTime?
  matchingStartedAt      DateTime?
  groupedAt              DateTime?
  bookedAt               DateTime?
  expiredAt              DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  user                   User                        @relation(fields: [userId], references: [id])
  faceVerification       GroupRideFaceVerification?

  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
  @@index([groupId, status, updatedAt])
  @@index([genderPreference, status])
}

model GroupRideFaceVerification {
  id             String                           @id @default(uuid())
  matchRequestId String                           @unique
  userId         String
  bucket         String
  objectKey      String
  mimeType       String
  sizeBytes      Int?
  etag           String?
  uploadStatus   GroupRideFaceVerificationStatus  @default(UPLOADING)
  capturedAt     DateTime?
  storedAt       DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  matchRequest   GroupRideMatchRequest            @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  user           User                             @relation(fields: [userId], references: [id])

  @@unique([bucket, objectKey])
  @@index([userId, uploadStatus, createdAt])
}

model Ride {
  id               String       @id @default(uuid())
  riderId          String
  driverId         String?
  status           RideStatus   @default(REQUESTED)
  pickupLat        Float
  pickupLng        Float
  pickupAddress    String
  destLat          Float
  destLng          Float
  destAddress      String
  fareEstimateUsdt Decimal?     @db.Decimal(18, 6)
  fareFinalUsdt    Decimal?     @db.Decimal(18, 6)
  platformFeeUsdt  Decimal?     @db.Decimal(18, 6)
  distanceKm       Float?
  durationSeconds  Int?
  cancelStage      CancelStage?
  cancelReason     String?
  penaltyUsdt      Decimal?     @db.Decimal(18, 6)
  recordingId      String?
  recordingCid     String?
  recordingHash    String?
  matchedAt        DateTime?
  arrivedAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  disputes         Dispute[]
  gpsLogs          GpsLog[]
  driver           Driver?      @relation("DriverRides", fields: [driverId], references: [id])
  routeStops       RideStop[]
  referralQualifications Referral[] @relation("ReferralFirstRide")

  @@index([riderId, createdAt])
  @@index([driverId, status])
  @@index([status])
}

model RideStop {
  id          String         @id @default(uuid())
  rideId      String
  stopOrder   Int
  type        RideStopType   @default(INTERMEDIATE)
  status      RideStopStatus @default(PENDING)
  lat         Float
  lng         Float
  address     String
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  ride        Ride           @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, stopOrder])
  @@index([rideId, status, stopOrder])
}

model ScheduledRide {
  id                     String                     @id @default(uuid())
  riderId                String
  riderWallet            String
  status                 ScheduledRideStatus        @default(SCHEDULED)
  paymentMethod          ScheduledRidePaymentMethod @default(WALLET_BALANCE)
  scheduledFor           DateTime
  requestedRideId        String?                    @unique
  pickupLat              Float
  pickupLng              Float
  pickupAddress          String
  destLat                Float
  destLng                Float
  destAddress            String
  stops                  Json?
  plannedDistanceKm      Float?
  plannedDurationSeconds Int?
  fareEstimateUsdt       Decimal?                   @db.Decimal(18, 6)
  cancellationReason     String?
  cancelledAt            DateTime?
  dispatchedAt           DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([riderId, scheduledFor])
  @@index([status, scheduledFor])
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code, isActive])
}

model Referral {
  id                       String              @id @default(uuid())
  referrerId               String
  referredUserId           String              @unique
  code                     String
  status                   ReferralStatus      @default(PENDING)
  appliedAt                DateTime            @default(now())
  expiresAt                DateTime
  closesAt                 DateTime
  firstRideId              String?
  qualifiedAt              DateTime?
  settledAt                DateTime?
  usedToUnlockCashbackId   String?             @unique
  unlockedAmountNgn        Decimal?            @db.Decimal(18, 2)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  referrer                 User                @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser             User                @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  firstRide                Ride?               @relation("ReferralFirstRide", fields: [firstRideId], references: [id])
  usedToUnlockCashback     ReferralCashback?   @relation("ReferralUnlockingReferral", fields: [usedToUnlockCashbackId], references: [id])
  cashbacks                ReferralCashback[]  @relation("ReferralSource")
  unlocks                  ReferralCashbackUnlock[]

  @@index([referrerId, status, appliedAt])
  @@index([referredUserId, status])
  @@index([expiresAt, status])
  @@index([closesAt, status])
}

model ReferralCashback {
  id                 String                  @id @default(uuid())
  userId             String
  sourceReferralId   String?
  type               ReferralCashbackType
  amountNgn          Decimal                 @db.Decimal(18, 2)
  remainingAmountNgn Decimal                 @db.Decimal(18, 2)
  status             ReferralCashbackStatus  @default(AVAILABLE)
  freezesAt          DateTime
  frozenAt           DateTime?
  usedAt             DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceReferral     Referral?               @relation("ReferralSource", fields: [sourceReferralId], references: [id])
  unlockedByReferral Referral?               @relation("ReferralUnlockingReferral")
  usages             ReferralCashbackUsage[]
  unlocks            ReferralCashbackUnlock[]

  @@index([userId, status, freezesAt])
  @@index([sourceReferralId])
}

model ReferralCashbackUsage {
  id          String                      @id @default(uuid())
  cashbackId  String
  rideId      String?
  amountNgn   Decimal                     @db.Decimal(18, 2)
  status      ReferralCashbackUsageStatus @default(RESERVED)
  createdAt   DateTime                    @default(now())
  settledAt   DateTime?
  releasedAt  DateTime?
  cashback    ReferralCashback            @relation(fields: [cashbackId], references: [id], onDelete: Cascade)

  @@index([cashbackId])
  @@index([rideId, status])
}

model ReferralCashbackUnlock {
  id          String            @id @default(uuid())
  referralId  String
  cashbackId  String
  amountNgn   Decimal           @db.Decimal(18, 2)
  createdAt   DateTime          @default(now())
  referral    Referral          @relation(fields: [referralId], references: [id], onDelete: Cascade)
  cashback    ReferralCashback  @relation(fields: [cashbackId], references: [id], onDelete: Cascade)

  @@unique([referralId, cashbackId])
  @@index([cashbackId])
}

model OutboxEvent {
  id          String   @id @default(uuid())
  topic       String
  key         String?
  payload     Json
  createdAt   DateTime @default(now())
  publishedAt DateTime?

  @@index([publishedAt, createdAt])
  @@index([createdAt])
}

model GpsLog {
  id        String   @id @default(uuid())
  rideId    String
  lat       Float
  lng       Float
  speedKmh  Float?
  timestamp DateTime
  ride      Ride     @relation(fields: [rideId], references: [id])

  @@index([rideId, timestamp])
}

model Recording {
  id              String   @id @default(uuid())
  rideId          String   @unique
  ipfsCid         String
  sha256Hash      String
  consentTxHash   String
  encryptedWith   String
  durationSeconds Int
  storedAt        DateTime @default(now())
  onchainTxHash   String?

  @@index([rideId])
}

model Dispute {
  id           String             @id @default(uuid())
  rideId       String
  openedBy     String
  openedByRole String
  againstId    String
  reason       String
  status       DisputeStatus      @default(OPEN)
  resolution   DisputeResolution?
  resolvedBy   String?
  notes        String?
  refundUsdt   Decimal?           @db.Decimal(18, 6)
  bonusUsdt    Decimal?           @db.Decimal(18, 6)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  ride         Ride               @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@index([openedBy])
  @@index([status])
}

model Feedback {
  id             String   @id @default(uuid())
  rideId         String
  reviewerId     String
  reviewerRole   String
  revieweeId     String
  revieweeWallet String
  rating         Int
  comment        String?
  commentHash    String?
  onchainTxHash  String?
  createdAt      DateTime @default(now())

  @@unique([rideId, reviewerId])
  @@index([revieweeId])
}

model DefiPosition {
  id             String             @id @default(uuid())
  walletId       String
  protocol       DefiProtocol
  tier           DefiTier
  stakedUsdt     Decimal            @db.Decimal(18, 6)
  expectedApyPct Float
  txHash         String
  chainId        Int
  status         DefiPositionStatus @default(ACTIVE)
  unstakeTxHash  String?
  createdAt      DateTime           @default(now())
  closedAt       DateTime?
  wallet         Wallet             @relation(fields: [walletId], references: [id])
  yieldHarvests  YieldHarvest[]

  @@index([walletId, status])
}

model YieldHarvest {
  id           String       @id @default(uuid())
  positionId   String
  yieldUsdt    Decimal      @db.Decimal(18, 6)
  apyActualPct Float
  periodDays   Int
  txHash       String
  chainId      Int
  harvestedAt  DateTime     @default(now())
  position     DefiPosition @relation(fields: [positionId], references: [id])

  @@index([positionId])
}

model Notification {
  id            String               @id @default(uuid())
  userId        String
  title         String
  body          String
  category      NotificationCategory
  referenceId   String?
  referenceType String?
  read          Boolean              @default(false)
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

model NotificationDevice {
  id               String   @id @default(uuid())
  userId           String
  expoPushToken    String   @unique
  platform         String?
  deviceName       String?
  appOwnership     String?
  enabled          Boolean  @default(true)
  lastRegisteredAt DateTime @default(now())
  lastDeliveredAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, updatedAt])
}

enum UserRole {
  RIDER
  DRIVER
  BOTH
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_RIDE
}

enum RideStatus {
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CancelStage {
  BEFORE_MATCH
  AFTER_MATCH
  DRIVER_EN_ROUTE
  ACTIVE_TRIP
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionType {
  FIAT_ONRAMP
  CRYPTO_DEPOSIT
  DRIVER_PAYOUT
  YIELD_HARVEST
  REFUND
  DISPUTE_RESOLUTION
  RIDE_PAYMENT
  PENALTY
  WITHDRAWAL
  DEFI_STAKE
  DEFI_UNSTAKE
}

enum WalletReservationKind {
  WITHDRAWAL
}

enum WalletReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum WithdrawalRequestStatus {
  PENDING
  FUNDS_RESERVED
  OFFRAMP_CREATED
  PROCESSING
  SETTLED
  FAILED
  EXPIRED
  CANCELLED
}

enum GroupRideMatchRequestStatus {
  PENDING_FACE_UPLOAD
  READY_FOR_MATCH
  MATCHING
  GROUPED
  BOOKED
  EXPIRED
  CANCELLED
}

enum GroupRideFaceVerificationStatus {
  UPLOADING
  STORED
  FAILED
}

enum GroupRideGenderPreference {
  ANY
  WOMEN_ONLY
  MEN_ONLY
}

enum DefiTier {
  TIER1
  TIER2
  TIER3
}

enum DefiProtocol {
  AAVE
  COMPOUND
  CURVE
  UNISWAP_LP
}

enum DefiPositionStatus {
  ACTIVE
  UNSTAKING
  CLOSED
}

enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  ESCALATED
}

enum DisputeResolution {
  FAVOUR_RIDER
  FAVOUR_DRIVER
  SPLIT
  NO_ACTION
}

enum ConsentType {
  RECORDING
  DEFI_TIER1
  DEFI_TIER2
  DEFI_TIER3
}

enum NotificationCategory {
  RIDE
  PAYMENT
  WALLET
  DEFI
  DISPUTE
  KYC
  SYSTEM
}

enum PaymentRecordStatus {
  RECEIVED
  CONVERTING
  CONVERTED
}

enum PaymentSessionType {
  ONRAMP
  OFFRAMP
}

enum PaymentIntentStatus {
  PENDING
  REQUIRES_USER_ACTION
  PROCESSING
  SETTLED
  FAILED
  EXPIRED
  CANCELLED
}

enum RideHoldStatus {
  ACTIVE
  RELEASED
  CHARGED
}

enum RideStopType {
  INTERMEDIATE
  FINAL
}

enum RideStopStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum ScheduledRideStatus {
  SCHEDULED
  DISPATCHING
  DISPATCHED
  CANCELLED
  EXPIRED
}

enum ScheduledRidePaymentMethod {
  WALLET_BALANCE
  SMART_ACCOUNT
}

enum ReferralStatus {
  PENDING
  QUALIFIED_RIDE
  EXPIRED_NO_RIDE
  CLOSED
}

enum ReferralCashbackType {
  RIDE_QUALIFIED
  NO_RIDE_EXPIRED
}

enum ReferralCashbackStatus {
  AVAILABLE
  FROZEN
  USED
  EXPIRED
}

enum ReferralCashbackUsageStatus {
  RESERVED
  SETTLED
  RELEASED
}
