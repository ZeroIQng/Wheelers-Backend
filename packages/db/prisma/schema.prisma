generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  privyDid      String         @unique
  walletAddress String?        @unique
  role          UserRole       @default(RIDER)
  name          String?
  phone         String?
  photoUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  email         String?
  driver        Driver?
  notifications Notification[]
  consents      UserConsent[]
  wallet        Wallet?

  @@index([privyDid])
  @@index([walletAddress])
  @@index([email])
}

model UserConsent {
  id             String      @id @default(uuid())
  userId         String
  consentType    ConsentType
  consentVersion String
  consentTxHash  String
  grantedAt      DateTime    @default(now())
  revokedAt      DateTime?
  user           User        @relation(fields: [userId], references: [id])

  @@unique([userId, consentType, consentVersion])
  @@index([userId])
}

model Driver {
  id                String            @id @default(uuid())
  userId            String            @unique
  status            DriverStatus      @default(OFFLINE)
  kycStatus         KycStatus         @default(PENDING)
  lat               Float?
  lng               Float?
  lastSeenAt        DateTime?
  vehicleMake       String?
  vehicleModel      String?
  vehiclePlate      String?
  vehicleYear       Int?
  licenceCid        String?
  insuranceCid      String?
  selfieHash        String?
  rating            Float             @default(5.0)
  totalRides        Int               @default(0)
  totalEarningsUsdt Decimal           @default(0) @db.Decimal(18, 6)
  user              User              @relation(fields: [userId], references: [id])
  kycReviews        DriverKycReview[]
  rides             Ride[]            @relation("DriverRides")

  @@index([status])
  @@index([kycStatus])
}

model DriverKycReview {
  id          String    @id @default(uuid())
  driverId    String
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  outcome     KycStatus
  notes       String?
  driver      Driver    @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

model Wallet {
  id             String          @id @default(uuid())
  userId         String          @unique
  address        String          @unique
  balanceUsdt    Decimal         @default(0) @db.Decimal(18, 6)
  lockedUsdt     Decimal         @default(0) @db.Decimal(18, 6)
  stakedUsdt     Decimal         @default(0) @db.Decimal(18, 6)
  chain          String          @default("base")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  defiPositions  DefiPosition[]
  rideHolds      RideHold[]
  transactions   Transaction[]
  virtualAccount VirtualAccount?
  user           User            @relation(fields: [userId], references: [id])

  @@index([address])
}

model VirtualAccount {
  id            String   @id @default(uuid())
  walletId      String   @unique
  bankName      String
  accountNumber String
  accountName   String
  korapayRef    String   @unique
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id])
}

model PaymentRecord {
  id                       String              @id @default(uuid())
  paymentId                String              @unique
  userId                   String
  provider                 String
  providerReference        String              @unique
  userWallet               String
  amountLocal              Decimal             @db.Decimal(18, 2)
  amountUsdt               Decimal?            @db.Decimal(18, 6)
  exchangeRate             Decimal?            @db.Decimal(18, 6)
  status                   PaymentRecordStatus @default(RECEIVED)
  conversionLeaseExpiresAt DateTime?
  metadata                 Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  localCurrency            String              @default("NGN")

  @@index([userId, status])
}

model PaymentIntent {
  id                  String              @id @default(uuid())
  paymentId           String              @unique
  userId              String
  provider            String
  providerReference   String              @unique
  sessionType         PaymentSessionType
  lifecycleStatus     PaymentIntentStatus @default(PENDING)
  providerStatus      String
  userWallet          String
  amountUsd           Decimal             @db.Decimal(18, 6)
  amountLocal         Decimal?            @db.Decimal(18, 2)
  localCurrency       String              @default("NGN")
  cryptoCurrency      String
  cryptoNetwork       String
  cryptoAmount        Decimal?            @db.Decimal(18, 6)
  chain               String?
  customerEmail       String?
  walletTag           String?
  settlementReference String?
  providerPayload     Json?
  metadata            Json?
  lastSyncedAt        DateTime?
  settledAt           DateTime?
  failedAt            DateTime?
  expiresAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, lifecycleStatus])
  @@index([sessionType, lifecycleStatus])
}

model RideHold {
  id                String         @id @default(uuid())
  rideId            String         @unique
  walletId          String
  riderId           String
  amountUsdt        Decimal        @db.Decimal(18, 6)
  status            RideHoldStatus @default(ACTIVE)
  settledAmountUsdt Decimal?       @db.Decimal(18, 6)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  settledAt         DateTime?
  wallet            Wallet         @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@index([riderId, status])
}

model Transaction {
  id           String               @id @default(uuid())
  walletId     String
  type         TransactionType
  direction    TransactionDirection
  amountUsdt   Decimal              @db.Decimal(18, 6)
  balanceAfter Decimal              @db.Decimal(18, 6)
  referenceId  String
  metadata     Json?
  createdAt    DateTime             @default(now())
  wallet       Wallet               @relation(fields: [walletId], references: [id])

  @@unique([walletId, type, direction, referenceId])
  @@index([walletId, createdAt])
  @@index([referenceId])
}

model Ride {
  id               String       @id @default(uuid())
  riderId          String
  driverId         String?
  status           RideStatus   @default(REQUESTED)
  pickupLat        Float
  pickupLng        Float
  pickupAddress    String
  destLat          Float
  destLng          Float
  destAddress      String
  fareEstimateUsdt Decimal?     @db.Decimal(18, 6)
  fareFinalUsdt    Decimal?     @db.Decimal(18, 6)
  platformFeeUsdt  Decimal?     @db.Decimal(18, 6)
  distanceKm       Float?
  durationSeconds  Int?
  cancelStage      CancelStage?
  cancelReason     String?
  penaltyUsdt      Decimal?     @db.Decimal(18, 6)
  recordingId      String?
  recordingCid     String?
  recordingHash    String?
  matchedAt        DateTime?
  arrivedAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  disputes         Dispute[]
  gpsLogs          GpsLog[]
  driver           Driver?      @relation("DriverRides", fields: [driverId], references: [id])
  routeStops       RideStop[]

  @@index([riderId, createdAt])
  @@index([driverId, status])
  @@index([status])
}

model RideStop {
  id          String         @id @default(uuid())
  rideId      String
  stopOrder   Int
  type        RideStopType   @default(INTERMEDIATE)
  status      RideStopStatus @default(PENDING)
  lat         Float
  lng         Float
  address     String
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  ride        Ride           @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, stopOrder])
  @@index([rideId, status, stopOrder])
}

model ScheduledRide {
  id                     String                     @id @default(uuid())
  riderId                String
  riderWallet            String
  status                 ScheduledRideStatus        @default(SCHEDULED)
  paymentMethod          ScheduledRidePaymentMethod @default(WALLET_BALANCE)
  scheduledFor           DateTime
  requestedRideId        String?                    @unique
  pickupLat              Float
  pickupLng              Float
  pickupAddress          String
  destLat                Float
  destLng                Float
  destAddress            String
  stops                  Json?
  plannedDistanceKm      Float?
  plannedDurationSeconds Int?
  fareEstimateUsdt       Decimal?                   @db.Decimal(18, 6)
  cancellationReason     String?
  cancelledAt            DateTime?
  dispatchedAt           DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([riderId, scheduledFor])
  @@index([status, scheduledFor])
}

model OutboxEvent {
  id          String   @id @default(uuid())
  topic       String
  key         String?
  payload     Json
  createdAt   DateTime @default(now())
  publishedAt DateTime?

  @@index([publishedAt, createdAt])
  @@index([createdAt])
}

model GpsLog {
  id        String   @id @default(uuid())
  rideId    String
  lat       Float
  lng       Float
  speedKmh  Float?
  timestamp DateTime
  ride      Ride     @relation(fields: [rideId], references: [id])

  @@index([rideId, timestamp])
}

model Recording {
  id              String   @id @default(uuid())
  rideId          String   @unique
  ipfsCid         String
  sha256Hash      String
  consentTxHash   String
  encryptedWith   String
  durationSeconds Int
  storedAt        DateTime @default(now())
  onchainTxHash   String?

  @@index([rideId])
}

model Dispute {
  id           String             @id @default(uuid())
  rideId       String
  openedBy     String
  openedByRole String
  againstId    String
  reason       String
  status       DisputeStatus      @default(OPEN)
  resolution   DisputeResolution?
  resolvedBy   String?
  notes        String?
  refundUsdt   Decimal?           @db.Decimal(18, 6)
  bonusUsdt    Decimal?           @db.Decimal(18, 6)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  ride         Ride               @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@index([openedBy])
  @@index([status])
}

model Feedback {
  id             String   @id @default(uuid())
  rideId         String
  reviewerId     String
  reviewerRole   String
  revieweeId     String
  revieweeWallet String
  rating         Int
  comment        String?
  commentHash    String?
  onchainTxHash  String?
  createdAt      DateTime @default(now())

  @@unique([rideId, reviewerId])
  @@index([revieweeId])
}

model DefiPosition {
  id             String             @id @default(uuid())
  walletId       String
  protocol       DefiProtocol
  tier           DefiTier
  stakedUsdt     Decimal            @db.Decimal(18, 6)
  expectedApyPct Float
  txHash         String
  chainId        Int
  status         DefiPositionStatus @default(ACTIVE)
  unstakeTxHash  String?
  createdAt      DateTime           @default(now())
  closedAt       DateTime?
  wallet         Wallet             @relation(fields: [walletId], references: [id])
  yieldHarvests  YieldHarvest[]

  @@index([walletId, status])
}

model YieldHarvest {
  id           String       @id @default(uuid())
  positionId   String
  yieldUsdt    Decimal      @db.Decimal(18, 6)
  apyActualPct Float
  periodDays   Int
  txHash       String
  chainId      Int
  harvestedAt  DateTime     @default(now())
  position     DefiPosition @relation(fields: [positionId], references: [id])

  @@index([positionId])
}

model Notification {
  id            String               @id @default(uuid())
  userId        String
  title         String
  body          String
  category      NotificationCategory
  referenceId   String?
  referenceType String?
  read          Boolean              @default(false)
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

enum UserRole {
  RIDER
  DRIVER
  BOTH
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_RIDE
}

enum RideStatus {
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CancelStage {
  BEFORE_MATCH
  AFTER_MATCH
  DRIVER_EN_ROUTE
  ACTIVE_TRIP
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionType {
  FIAT_ONRAMP
  CRYPTO_DEPOSIT
  DRIVER_PAYOUT
  YIELD_HARVEST
  REFUND
  DISPUTE_RESOLUTION
  RIDE_PAYMENT
  PENALTY
  WITHDRAWAL
  DEFI_STAKE
  DEFI_UNSTAKE
}

enum DefiTier {
  TIER1
  TIER2
  TIER3
}

enum DefiProtocol {
  AAVE
  COMPOUND
  CURVE
  UNISWAP_LP
}

enum DefiPositionStatus {
  ACTIVE
  UNSTAKING
  CLOSED
}

enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  ESCALATED
}

enum DisputeResolution {
  FAVOUR_RIDER
  FAVOUR_DRIVER
  SPLIT
  NO_ACTION
}

enum ConsentType {
  RECORDING
  DEFI_TIER1
  DEFI_TIER2
  DEFI_TIER3
}

enum NotificationCategory {
  RIDE
  PAYMENT
  WALLET
  DEFI
  DISPUTE
  KYC
  SYSTEM
}

enum PaymentRecordStatus {
  RECEIVED
  CONVERTING
  CONVERTED
}

enum PaymentSessionType {
  ONRAMP
  OFFRAMP
}

enum PaymentIntentStatus {
  PENDING
  REQUIRES_USER_ACTION
  PROCESSING
  SETTLED
  FAILED
  EXPIRED
  CANCELLED
}

enum RideHoldStatus {
  ACTIVE
  RELEASED
  CHARGED
}

enum RideStopType {
  INTERMEDIATE
  FINAL
}

enum RideStopStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum ScheduledRideStatus {
  SCHEDULED
  DISPATCHING
  DISPATCHED
  CANCELLED
  EXPIRED
}

enum ScheduledRidePaymentMethod {
  WALLET_BALANCE
  SMART_ACCOUNT
}
