{
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspaces --if-present run dev",
    "build": "npm --workspaces --if-present run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint",
    "infra:up": "sh ./scripts/start-infra.sh",
    "start:core-services": "sh ./scripts/start-core-services.sh",
    "start:local": "npm run infra:up && npm run db:migrate:deploy && npm run start:core-services",

    "start:api-gateway": "npm -w @wheleers/api-gateway run start",
    "start:ride-service": "npm -w @wheleers/ride-service run start",
    "start:group-ride": "npm -w @wheleers/group-ride run start",
    "start:payment-service": "npm -w @wheleers/payment-service run start",
    "start:wallet-service": "npm -w @wheleers/wallet-service run start",
    "start:notification-worker": "npm -w @wheleers/notification-worker run start",
    "start:compliance-worker": "npm -w @wheleers/compliance-worker run start",
    "start:defi-scheduler": "npm -w @wheleers/defi-scheduler run start",

    "db:generate": "npm -w @wheleers/db run db:generate",
    "db:migrate:dev": "npm -w @wheleers/db run db:migrate:dev",
    "db:migrate:deploy": "npm -w @wheleers/db run db:migrate:deploy",
    "db:studio": "npm -w @wheleers/db run db:studio",
    "test:ride-service": "tsc -p test/tsconfig.json && node test/dist/ride-service.smoke.js",
    "test:group-ride": "npm run build && node --test test/group-ride.test.js",
    "test:group-ride:live": "npm run build && node --test test/group-ride.live.test.js",
    "test:payment-service": "npm run build && node --test test/payment-service.test.js",
    "test:wallet-service": "npm run build && node --test test/wallet-service.test.js",
    "test:wallet-payment-integration": "npm run build && tsc -p test/tsconfig.json && node test/dist/payment-wallet.integration.js"
  },
  "name": "wheelers-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeroIQng/Wheelers-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ZeroIQng/Wheelers-Backend/issues"
  },
  "homepage": "https://github.com/ZeroIQng/Wheelers-Backend#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "kafkajs": "^2.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
