{
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspaces --if-present run dev",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm -w @wheleers/config run build && npm -w @wheleers/kafka-schemas run build && npm -w @wheleers/kafka-client run build && npm -w @wheleers/db run build && npm -w @wheleers/multi-chain-wallet run build && npm -w @wheleers/pouch-client run build",
    "build:apps": "npm -w @wheleers/group-ride run build && npm -w @wheleers/notification-worker run build && npm -w @wheleers/payment-service run build && npm -w @wheleers/ride-service run build && npm -w @wheleers/wallet-service run build && npm -w @wheleers/api-gateway run build && npm -w @wheleers/whatsapp-gateway run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint",
    "infra:up": "sh ./scripts/start-infra.sh",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=200",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "start:local": "npm run infra:up && npm run build && npm run db:migrate:deploy && npm run pm2:start",
    "start:api-gateway": "npm -w @wheleers/api-gateway run start",
    "start:ride-service": "npm -w @wheleers/ride-service run start",
    "start:group-ride": "npm -w @wheleers/group-ride run start",
    "start:payment-service": "npm -w @wheleers/payment-service run start",
    "start:wallet-service": "npm -w @wheleers/wallet-service run start",
    "start:notification-worker": "npm -w @wheleers/notification-worker run start",
    "start:whatsapp-gateway": "npm -w @wheleers/whatsapp-gateway run start",
    "start:compliance-worker": "npm -w @wheleers/compliance-worker run start",
    "db:generate": "node scripts/run-with-env.cjs npm -w @wheleers/db run db:generate",
    "db:migrate:dev": "node scripts/run-with-env.cjs npm -w @wheleers/db run db:migrate:dev",
    "db:migrate:deploy": "node scripts/run-with-env.cjs npm -w @wheleers/db run db:migrate:deploy",
    "db:studio": "node scripts/run-with-env.cjs npm -w @wheleers/db run db:studio",
    "test:ride-service": "tsc -p test/tsconfig.json && node test/dist/ride-service.smoke.js",
    "test:ride-cancel": "tsc -p test/tsconfig.json && node test/dist/ride-cancel.integration.js",
    "test:group-ride": "npm run build && node --test test/group-ride.test.js",
    "test:group-ride:live": "npm run build && node --test test/group-ride.live.test.js",
    "test:payment-service": "npm run build && node --test test/payment-service.test.js",
    "test:wallet-service": "npm run build && node --test test/wallet-service.test.js",
    "test:wallet-payment-integration": "npm run build && tsc -p test/tsconfig.json && node test/dist/payment-wallet.integration.js",
    "test:driver-reonline": "tsc -p test/tsconfig.json && node test/dist/driver-reonline.integration.js"
  },
  "name": "wheelers-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeroIQng/Wheelers-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ZeroIQng/Wheelers-Backend/issues"
  },
  "homepage": "https://github.com/ZeroIQng/Wheelers-Backend#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "kafkajs": "^2.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}