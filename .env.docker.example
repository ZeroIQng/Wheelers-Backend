NODE_ENV=production
POSTGRES_DB=wheelers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PORT=3000
AWS_REGION=us-east-1
STELLAR_NETWORK=mainnet
# Do not place the Stellar private key in this file for production.
# Store a JSON secret in AWS Secrets Manager and reference it by name here.
STELLAR_MASTER_WALLET_SECRET_NAME=prod/wheelers/stellar/master-wallet
PRIVY_APP_ID=replace-me
# Docker Compose cannot parse multiline PEM blocks in env files.
# Keep this on one line and use literal \n separators.
PRIVY_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----
WHATSAPP_GATEWAY_URL=http://host.docker.internal:3010
WHATSAPP_GATEWAY_PORT=3010
WHATSAPP_GATEWAY_TOKEN=replace-me
WHATSAPP_OTP_TTL_SECONDS=300
# whatsapp-gateway process (recommended on a separate host or VM)
# WHATSAPP_CLIENT_ID=wheelers-otp
# WHATSAPP_SESSION_PATH=/var/lib/wheelers-whatsapp/.wwebjs_auth
# WHATSAPP_HEADLESS=true
# WHATSAPP_CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
# Legacy SMS fallback:
# TWILIO_ACCOUNT_SID=replace-me
# TWILIO_AUTH_TOKEN=replace-me
# TWILIO_FROM_NUMBER=+10000000000
POUCH_API_KEY=replace-me
POUCH_BASE_URL=https://api.pouch.finance
POUCH_WEBHOOK_SECRET=replace-me
POUCH_PROVIDER_ID=yellowcard
POUCH_COUNTRY_CODE=NG
POUCH_FIAT_CURRENCY=NGN
POUCH_CRYPTO_CURRENCY=USDC
POUCH_CRYPTO_NETWORK=XLM
POUCH_CHAIN=XLM
POUCH_MASTER_WALLET_ADDRESS=replace-me
POUCH_WALLET_TAG=optional-memo
POUCH_TEST_EMAIL=you@example.com
GOOGLE_MAPS_API_KEY=replace-me
GOOGLE_MAPS_BASE_URL=https://routes.googleapis.com
GROUP_RIDE_FACE_S3_BUCKET=replace-me
GROUP_RIDE_FACE_S3_PREFIX=group-rides/face-verification
GROUP_RIDE_FACE_UPLOAD_URL_TTL_S=900
GROUP_RIDE_PICKUP_RADIUS_KM=2.5
GROUP_RIDE_DESTINATION_RADIUS_KM=6
GROUP_RIDE_BEARING_THRESHOLD_DEG=35
GROUP_RIDE_MAX_CANDIDATES=6
GROUP_RIDE_MAX_SIZE=3
GROUP_RIDE_REQUEST_TTL_S=600
PAYMENT_PROVIDER=pouch
PLATFORM_WALLET_ADDRESS=replace-me
PLATFORM_PRIVATE_KEY=replace-me
RPC_URL_BASE=http://host.docker.internal:8545
CORS_ORIGINS=https://api.example.com,https://app.example.com

# Add any extra worker-only values here when you enable those profiles:
# EXPO_ACCESS_TOKEN=replace-me
# IDLE_THRESHOLD_USDT=50
# IDLE_HOURS=24
